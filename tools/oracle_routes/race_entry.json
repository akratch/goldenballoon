{
  "schema": "mdkr64.oracle.route.v1",
  "name": "race_entry",
  "description": "Best-effort race entry: title -> character select -> confirm a character -> attempt to proceed toward a race. The native port may not reach in-race rendering yet; this captures whatever renders at each mark so the emulator reference is available when it does. Inputs past character-select are exploratory.",
  "native_cadence": "enhanced",
  "native_synth_fields": 1,
  "sync": { "event": "title", "native_frame": 1134, "ares_frame": 1340 },
  "native": { "frames": 1900, "dump_every": 30, "dump_start": 1100 },
  "ares":   { "frames": 2100, "dump_every": 30, "dump_start": 1300 },
  "marks": [
    { "name": "title",        "logical": 0 },
    { "name": "char_select",  "logical": 260 },
    { "name": "char_picked",  "logical": 420 },
    { "name": "confirmed",    "logical": 560 },
    { "name": "proceed",      "logical": 700 }
  ],
  "events": [
    { "frame": 1250, "buttons": ["start"], "hold": 4 },
    { "frame": 1330, "buttons": ["start"], "hold": 4 },
    { "frame": 1490, "buttons": ["a"],     "hold": 4 },
    { "frame": 1630, "buttons": ["a"],     "hold": 4 },
    { "frame": 1770, "buttons": ["a"],     "hold": 4 }
  ]
}
