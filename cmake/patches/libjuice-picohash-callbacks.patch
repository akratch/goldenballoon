+/* Generic callbacks must have the exact declared function type. Keep the
+ * algorithm-specific contexts behind typed adapters rather than casting
+ * incompatible function pointers (undefined behavior under Clang UBSan). */
+#define _PICOHASH_CALLBACKS(name, member, update_name) \
+    static void _picohash_##name##_reset_callback(void *opaque) \
+    { _picohash_##name##_init(&((picohash_ctx_t *)opaque)->member); } \
+    static void _picohash_##name##_update_callback(void *opaque, const void *data, size_t len) \
+    { _picohash_##update_name##_update(&((picohash_ctx_t *)opaque)->member, data, len); } \
+    static void _picohash_##name##_final_callback(void *opaque, void *digest) \
+    { _picohash_##name##_final(&((picohash_ctx_t *)opaque)->member, digest); }
+_PICOHASH_CALLBACKS(md5, _md5, md5)
+_PICOHASH_CALLBACKS(sha1, _sha1, sha1)
+_PICOHASH_CALLBACKS(sha224, _sha256, sha256)
+_PICOHASH_CALLBACKS(sha256, _sha256, sha256)
+#undef _PICOHASH_CALLBACKS
+
